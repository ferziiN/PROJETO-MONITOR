{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MonitorDb": "Host=localhost;Port=5432;Database=monitor;Username=monitor;Password=monitor"
  },
  "BancoDeDados": {
    "AplicarMigrationsAoIniciar": false
  },
  "Monitoramento": {
    "Habilitado": true,
    "IntervaloVarreduraSegundos": 5,
    "TimeoutSegundos": 5,
    "LimiteAtencaoMs": 1000,
    "MaxVerificacoesSimultaneas": 10,
    "MetodoHttp": "GET",
    "RetencaoHistoricoDias": 30
  },
  "Cors": {
    "OrigensPermitidas": []
  }
}
